rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // שלב 2 אבטחה: גישה רק עם Custom Token שהונפק ע"י Cloud Function login
    // (טוקן אנונימי אין לו role claim — נחסם)
    function hasRole() {
      return request.auth != null
        && ('role' in request.auth.token)
        && request.auth.token.role in ['manager', 'supervisor', 'worker', 'helper'];
    }
    function isMgr() {
      return request.auth != null
        && ('role' in request.auth.token)
        && request.auth.token.role == 'manager';
    }
    function isSup() {
      return request.auth != null
        && ('role' in request.auth.token)
        && request.auth.token.role == 'supervisor';
    }

    // סודות כניסה (hash סיסמה, תבניות פנים, מזהה מכשיר) — אין גישת לקוח בכלל,
    // רק Cloud Functions דרך Admin SDK
    match /credentials/{id} {
      allow read, write: if false;
    }

    // הגדרות רגישות (עלויות/שכר) — מנהל בלבד
    match /adminSettings/{docId} {
      allow read, write: if isMgr();
    }

    // עובדים: קריאה לכל מחובר; יצירה/מחיקה למנהל; עדכון מותר לכולם (חתימות
    // נוכחות/משימות כותבות לעובדים אחרים) אבל בלי לשנות שדות אבטחה/תפקיד
    match /workers/{id} {
      allow read: if hasRole();
      allow create, delete: if isMgr();
      allow update: if isMgr() || (hasRole()
        && request.resource.data.get('role', '') == resource.data.get('role', '')
        && request.resource.data.get('user', '') == resource.data.get('user', '')
        && request.resource.data.get('deviceBinding', false) == resource.data.get('deviceBinding', false)
        && request.resource.data.get('faceAuth', false) == resource.data.get('faceAuth', false)
        && request.resource.data.get('requireFactoryIP', false) == resource.data.get('requireFactoryIP', false)
        && request.resource.data.get('disabled', false) == resource.data.get('disabled', false)
        && request.resource.data.get('faceUpdateAllowed', false) == resource.data.get('faceUpdateAllowed', false)
        && request.resource.data.get('accessWindow', {}) == resource.data.get('accessWindow', {})
        // מדיניות השערים 🔒/🔗 היא ערך אכיפה — עובד שיכול לכתוב אותה על עצמו
        // פוטר את עצמו מהחסימה, ולכן היא נעולה למנהל כמו יתר שדות האבטחה
        && request.resource.data.get('stationGateMode', '') == resource.data.get('stationGateMode', '')
        && request.resource.data.get('stepOrderGateMode', '') == resource.data.get('stepOrderGateMode', '')
        && request.resource.data.get('permissions', []) == resource.data.get('permissions', []));
    }

    // הגדרות אפליקציה: קריאה לכולם (עובדים צריכים shiftEnd/factoryIP/לקוחות/צבעים);
    // telegramSettings כתיבה למנהל בלבד — factoryIP/shiftEnd הם ערכי אכיפה
    // שפונקציות login/wifiMonitor/attendanceCloser מסתמכות עליהם
    match /appSettings/{docId} {
      allow read: if hasRole();
      allow write: if isMgr() || (hasRole() && docId != 'telegramSettings');
    }

    // תחנות עבודה (מצלמות/DVR): עובד קורא (לזיהוי סריקת STN), מנהל מגדיר
    match /stations/{id} {
      allow read: if hasRole();
      allow write: if isMgr();
    }

    // 🧾 קופת המפעל: כל בעל גישה רואה את התנועות ורושם **לקיחה** על שמו בלבד.
    // הכנסת כסף (type=='in') והמחיקה — מנהל בלבד. הסתרת הכפתור בלקוח אינה
    // אכיפה; בלי החוק הזה עובד יכול לרשום הפקדה ולנפח את היתרה.
    // uid בטוקן שווה למזהה העובד (createCustomToken(w.id)) ⇒ אי אפשר לרשום על שם אחר.
    match /cashbox/{id} {
      allow read: if hasRole();
      allow create: if isMgr() || (hasRole()
        && request.resource.data.type == 'out'
        && request.resource.data.workerId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0);
      allow update, delete: if isMgr();
    }

    // 💸 הוצאות עובדים (25/09/2026): עובד/עוזר רואה ורושם **רק את שלו**; אחראי ומנהל רואים הכל.
    // עריכה ומחיקה — מנהל בלבד. עד כה האוסף נפל ל-catch-all: כל מחובר קרא, ערך ומחק
    // הוצאות של כולם (כולל תמונות קבלה), וההסתרה במסך לא הייתה אכיפה.
    // ⚠️ Rules אינם מסננים: הלקוח של עובד חייב להאזין עם where('workerId','==',uid),
    // אחרת כל ההאזנה נדחית. uid בטוקן = מזהה העובד (createCustomToken(w.id)).
    match /workerExpenses/{id} {
      allow read: if isMgr() || isSup()
        || (hasRole() && resource.data.workerId == request.auth.uid);
      allow create: if isMgr() || (hasRole()
        && request.resource.data.workerId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0);
      allow update, delete: if isMgr();
    }

    // שאר האוספים — כל משתמש מחובר עם role
    // (stationLog נשאר כאן בכוונה — עובדים כותבים רשומות שיוך לתחנה)
    // ⚠️ כל אוסף שמקבל חוקים משלו חייב להופיע כאן ברשימת ההחרגה — Rules מאשרים
    // אם **איזשהו** match מאשר, ולכן בלי ההחרגה ה-catch-all היה עוקף את החוק הייעודי.
    match /{collection}/{docId} {
      allow read, write: if hasRole()
        && collection != 'credentials'
        && collection != 'adminSettings'
        && collection != 'workers'
        && collection != 'appSettings'
        && collection != 'stations'
        && collection != 'workerExpenses'
        // עד 25/09/2026 חסר כאן — וחוק הקופה הייעודי (לקיחה בלבד, על שמך) לא נאכף בפועל
        && collection != 'cashbox';
    }
  }
}
