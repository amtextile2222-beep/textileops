rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // שלב 2 אבטחה: גישה רק עם Custom Token שהונפק ע"י Cloud Function login
    // (טוקן אנונימי אין לו role claim — נחסם)
    function hasRole() {
      return request.auth != null
        && ('role' in request.auth.token)
        && request.auth.token.role in ['manager', 'supervisor', 'worker', 'helper'];
    }
    function isMgr() {
      return request.auth != null
        && ('role' in request.auth.token)
        && request.auth.token.role == 'manager';
    }
    function isSup() {
      return request.auth != null
        && ('role' in request.auth.token)
        && request.auth.token.role == 'supervisor';
    }

    // סודות כניסה (hash סיסמה, תבניות פנים, מזהה מכשיר) — אין גישת לקוח בכלל,
    // רק Cloud Functions דרך Admin SDK
    match /credentials/{id} {
      allow read, write: if false;
    }

    // הגדרות רגישות (עלויות/שכר) — מנהל בלבד
    match /adminSettings/{docId} {
      allow read, write: if isMgr();
    }

    // עובדים: קריאה לכל מחובר; יצירה/מחיקה למנהל; עדכון מותר לכולם (חתימות
    // נוכחות/משימות כותבות לעובדים אחרים) אבל בלי לשנות שדות אבטחה/תפקיד
    match /workers/{id} {
      allow read: if hasRole();
      allow create, delete: if isMgr();
      allow update: if isMgr() || (hasRole()
        && request.resource.data.get('role', '') == resource.data.get('role', '')
        && request.resource.data.get('user', '') == resource.data.get('user', '')
        && request.resource.data.get('deviceBinding', false) == resource.data.get('deviceBinding', false)
        && request.resource.data.get('faceAuth', false) == resource.data.get('faceAuth', false)
        && request.resource.data.get('requireFactoryIP', false) == resource.data.get('requireFactoryIP', false)
        && request.resource.data.get('disabled', false) == resource.data.get('disabled', false)
        && request.resource.data.get('faceUpdateAllowed', false) == resource.data.get('faceUpdateAllowed', false)
        && request.resource.data.get('accessWindow', {}) == resource.data.get('accessWindow', {})
        // מדיניות השערים 🔒/🔗 היא ערך אכיפה — עובד שיכול לכתוב אותה על עצמו
        // פוטר את עצמו מהחסימה, ולכן היא נעולה למנהל כמו יתר שדות האבטחה
        && request.resource.data.get('stationGateMode', '') == resource.data.get('stationGateMode', '')
        && request.resource.data.get('stepOrderGateMode', '') == resource.data.get('stepOrderGateMode', '')
        && request.resource.data.get('permissions', []) == resource.data.get('permissions', [])
        // 🎙 הרשאת קשר קולי (06/11/2026) — המנהל קובע; עובד לא פותח לעצמו ערוץ
        && request.resource.data.get('voiceMode', '') == resource.data.get('voiceMode', '')
        && request.resource.data.get('voiceTo', []) == resource.data.get('voiceTo', []));
    }

    // 🎙 הודעות קוליות (מכשיר קשר, 06/11/2026). to = רשימת נמענים, aud = הקלטה (data URL).
    // רק המנהל שולח לכל אחד וקורא את כל השיחות. כל השאר (גם אחראי) לפי מה שהמנהל קבע בכרטיס:
    // voiceMode 'open' ⇒ רק לנמענים שברשימה voiceTo (בלי רשימה — כמו קודם: מנהל/אחראי אחד);
    // ברירת מחדל ('') ⇒ רק תשובה לשולח של הודעה שקיבל (replyTo); 'off' ⇒ לא שולח בכלל.
    // שינוי אחרי שליחה — רק "שמעתי" של הנמען עצמו.
    function voiceTarget(uid) {
      return get(/databases/$(database)/documents/workers/$(uid)).data.get('role', '') in ['manager', 'supervisor'];
    }
    function voiceReplyOk(d) {
      return d.get('replyTo', '') is string && d.get('replyTo', '') != ''
        && exists(/databases/$(database)/documents/voiceMsgs/$(d.replyTo))
        && get(/databases/$(database)/documents/voiceMsgs/$(d.replyTo)).data.from == d.to[0]
        && request.auth.uid in get(/databases/$(database)/documents/voiceMsgs/$(d.replyTo)).data.to;
    }
    match /voiceMsgs/{id} {
      allow read: if isMgr() || (hasRole() && (request.auth.uid in resource.data.to || resource.data.from == request.auth.uid));
      allow create: if hasRole()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is list
        && request.resource.data.to.size() > 0
        && request.resource.data.aud is string
        && request.resource.data.aud.size() < 900000
        && request.resource.data.heard == {}
        && (isMgr()
          || (me().get('voiceMode', '') == 'open' && me().get('voiceTo', []).size() > 0
            && me().get('voiceTo', []).hasAll(request.resource.data.to))
          || (request.resource.data.to.size() == 1 && me().get('voiceMode', '') != 'off'
            && ((me().get('voiceMode', '') == 'open' && me().get('voiceTo', []).size() == 0
                && voiceTarget(request.resource.data.to[0]))
              || voiceReplyOk(request.resource.data))));
      allow update: if hasRole() && request.auth.uid in resource.data.to
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['heard'])
        && request.resource.data.heard.diff(resource.data.heard).affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if isMgr() || (hasRole() && resource.data.from == request.auth.uid);
    }

    // הגדרות אפליקציה: קריאה לכולם (עובדים צריכים shiftEnd/factoryIP/לקוחות/צבעים);
    // telegramSettings כתיבה למנהל בלבד — factoryIP/shiftEnd הם ערכי אכיפה
    // שפונקציות login/wifiMonitor/attendanceCloser מסתמכות עליהם
    // 🔒 (12/11/2026) עד היום כל מחובר כתב לכל מסמך חוץ מ-telegramSettings — עובדת יכלה לרשום את עצמה
    // ב-pushSettings כמנהל (ולקבל את כל ההתראות), לשנות מלאי, מחלקות ושמות לקוחות. עכשיו לפי מסמך:
    // · נעילות/רישומים שכל מכשיר כותב בטרנזקציה (דוח יומי, התראות, מונה תעודות) — כל מחובר
    // · מלאי, לקוחות, צבעים, מחלקות, ביטולי תעודות, מונה חשבוניות — אחראי, או מי שמורשה לתמחור/תעודות
    // · pushSettings — אחראי רושם/מעדכן **מכשיר אחד** בלבד (initFCM); הגדרות והסרה — מנהל
    // · כל השאר (telegramSettings, rateW, breakDefault, company, packPrices, מסמך חדש) — מנהל בלבד
    // ⚠️ מסמך חדש ב-appSettings שעובד/אחראי צריך לכתוב — להוסיף כאן, אחרת הכתיבה נדחית.
    function pushTokenOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tokens', 'lastRegistered'])
        && request.resource.data.tokens is map
        && request.resource.data.tokens.diff(resource.data.get('tokens', {})).removedKeys().size() == 0
        && request.resource.data.tokens.diff(resource.data.get('tokens', {})).affectedKeys().size() <= 1;
    }
    match /appSettings/{docId} {
      allow read: if hasRole();
      allow create, update: if isMgr()
        || (hasRole() && docId in ['dailyReport', 'endOfDayAlert', 'punchOutAlert', 'tgAlertLog', 'deliveryNote'])
        || ((isSup() || canPricing()) && docId in ['packStock', 'customerNames', 'customerInfo', 'customColors', 'depts', 'deliveryVoids', 'proformaInvoice']);
      allow update: if isSup() && docId == 'pushSettings' && pushTokenOnly();
      // מחיקת מסמך הגדרות (לקוחות/מחלקות/צבעים) משבשת את כולם — האפליקציה לא מוחקת אף אחד
      allow delete: if isMgr();
    }

    // תחנות עבודה (מצלמות/DVR): עובד קורא (לזיהוי סריקת STN), מנהל מגדיר
    match /stations/{id} {
      allow read: if hasRole();
      allow write: if isMgr();
    }

    // 🧾 קופת המפעל: כל בעל גישה רואה את התנועות ורושם **לקיחה** על שמו בלבד.
    // הכנסת כסף (type=='in') והמחיקה — מנהל בלבד. הסתרת הכפתור בלקוח אינה
    // אכיפה; בלי החוק הזה עובד יכול לרשום הפקדה ולנפח את היתרה.
    // uid בטוקן שווה למזהה העובד (createCustomToken(w.id)) ⇒ אי אפשר לרשום על שם אחר.
    // 🔒 (13/11/2026) רק מי שרואה את לשונית הקופה: מנהל · permissions שכולל 'cashbox' · בלי permissions = ברירת
    // המחדל של התפקיד (כוללת קופה). ⚠️ חייב להישאר זהה ל-_canCashbox בלקוח. עד היום כל עובד קרא את כל התנועות.
    function canCashbox() {
      return isMgr() || (hasRole() && (!('permissions' in me()) || me().permissions.hasAny(['cashbox'])));
    }
    match /cashbox/{id} {
      allow read: if canCashbox();
      allow create: if isMgr() || (canCashbox()
        && request.resource.data.type == 'out'
        && request.resource.data.workerId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0);
      allow update, delete: if isMgr();
    }

    // 🗑 הגנה ממחיקה (25/09/2026): קריאה/יצירה/עדכון נשארים לכל מחובר — האפליקציה עצמה
    // כותבת רשומות של אחרים מכל מכשיר (סגירת נוכחות בבוקר, איפוס חצות, משימות משותפות).
    // מחיקה — רק מי שיש לו אותה במסך: נוכחות אינה נמחקת מהאפליקציה בכלל (מנהל בלבד);
    // היסטוריית משימות ומוצרים נמחקים ממסכי מנהל/אחראי (deleteHistTask/restoreHistTask/deleteProduct).
    match /attHistory/{id} {
      allow read, create, update: if hasRole();
      allow delete: if isMgr();
    }
    match /histTasks/{id} {
      allow read, create, update: if hasRole();
      allow delete: if isMgr() || isSup();
    }
    match /products/{id} {
      allow read, create, update: if hasRole();
      allow delete: if isMgr() || isSup();
    }

    // 💲 תמחור מוצרים (25/09/2026): מחיר ללקוח, אחוז רווח, עלות חומרים, גזירה — הוצאו ממסמכי
    // products (שנטענים לכל טלפון) לאוסף נפרד. רשאים: מנהל · מי שסומן לו "מוצרים" או
    // "תעודות משלוח" · אחראי בלי הרשאות מפורשות (ברירת המחדל שלו כוללת "מוצרים").
    // ⚠️ חייב להישאר זהה ל-_canPricing ב-index.html. חישוב הצפי בשרת (calcTaskExpected) קורא
    // דרך Admin SDK ולא תלוי בזה — עובדת ממשיכה לקבל צפי בלי לראות מחיר.
    function me() {
      return get(/databases/$(database)/documents/workers/$(request.auth.uid)).data;
    }
    function canPricing() {
      return isMgr() || (hasRole() && (
        ('permissions' in me() && me().permissions.hasAny(['products', 'dnotes']))
        || (!('permissions' in me()) && request.auth.token.role == 'supervisor')));
    }
    // 🧾 חשבוניות עסקה (04/10/2026) — מכילות מחירים ⇒ אותה הרשאה כמו התמחור.
    // יצירה (בהפקה) ועדכון (סימון "מבוטלת") — לא מוחקים: המספר לא חוזר לשימוש.
    // ✍ חתימת העסק (05/10/2026) — מי שמדפיס תעודות/חשבוניות קורא; רק מנהל מחליף/מוחק.
    match /bizSignature/{id} {
      allow read: if canPricing();
      allow write: if isMgr();
    }
    match /proformaInvoices/{id} {
      allow read, create, update: if canPricing();
      allow delete: if false;
    }
    // 💳 צילומי שיקים (08/10/2026) — מספרי חשבון בנק ⇒ רק מי שרואה חשבוניות. מחיקה — מנהל
    match /checkImages/{id} {
      allow read, create, update: if canPricing();
      allow delete: if isMgr();
    }
    match /productPricing/{id} {
      allow read, create, update: if canPricing();
      // כמו מחיקת מוצר — מנהל/אחראי (deleteProduct מוחק גם את התמחור, שלא יישאר יתום)
      allow delete: if isMgr() || isSup();
    }

    // 💸 הוצאות עובדים (25/09/2026): עובד/עוזר רואה ורושם **רק את שלו**; אחראי ומנהל רואים הכל.
    // עריכה ומחיקה — מנהל בלבד. עד כה האוסף נפל ל-catch-all: כל מחובר קרא, ערך ומחק
    // הוצאות של כולם (כולל תמונות קבלה), וההסתרה במסך לא הייתה אכיפה.
    // ⚠️ Rules אינם מסננים: הלקוח של עובד חייב להאזין עם where('workerId','==',uid),
    // אחרת כל ההאזנה נדחית. uid בטוקן = מזהה העובד (createCustomToken(w.id)).
    match /workerExpenses/{id} {
      allow read: if isMgr() || isSup()
        || (hasRole() && resource.data.workerId == request.auth.uid);
      allow create: if isMgr() || (hasRole()
        && request.resource.data.workerId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0);
      allow update, delete: if isMgr();
    }

    // ── 🔒 (12/11/2026) אוספים שיצאו מה-catch-all ──────────────────────────────────────────
    // 🖼 תמונות לדף הלקוח (דגם / חומר). כל מי ששומר תמונות מוצר כותב לכאן, ולכן הכתיבה נשארת פתוחה —
    // אבל רק תמונת data: תקינה. הערך מוצג בדף הלקוח ובתצוגת המנהל; מחרוזת אחרת הייתה מוזרקת ל-HTML.
    match /thumbs/{id} {
      allow read, delete: if hasRole();
      allow create, update: if hasRole()
        && request.resource.data.img is string
        && request.resource.data.img.matches('data:image/(jpeg|png|webp|gif);base64,[A-Za-z0-9+/=]+');
    }
    // נעילות ורישומי התראות של השרת בלבד (longTaskMonitor / remindLateTask / wifiMonitor, Admin SDK)
    match /taskAlerts/{id} { allow read, write: if false; }
    match /wifiAlerts/{id} { allow read, write: if false; }
    // 📡 IP שהעובד מדווח: כל אחד את שלו; אחראי/מנהל — גם של אחרים (החתמה קבוצתית / יציאה מהניהול)
    match /workerWifi/{id} {
      allow read, write: if isMgr() || isSup() || (hasRole() && request.auth.uid == id);
    }
    // 📢 הודעת מנהל/אחראי לעובד (מסמך אחד לעובד). העובד קורא את שלו ומסמן "נקרא" בלבד
    match /workerMessages/{id} {
      allow read: if isMgr() || isSup() || (hasRole() && request.auth.uid == id);
      allow write: if isMgr() || isSup();
      allow create: if hasRole() && request.auth.uid == id
        && request.resource.data.keys().hasOnly(['ts', 'read']);
      allow update: if hasRole() && request.auth.uid == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ts', 'read']);
    }
    // 📨 הודעת עובד למנהל: כל אחד שולח בשמו; קוראים ומסמנים — מנהל/אחראי
    match /mgrInbox/{id} {
      allow create: if hasRole() && request.resource.data.fromId == request.auth.uid;
      allow read, update, delete: if isMgr() || isSup();
    }
    // 🚪 יומן השערים: כל מכשיר רושם אירוע; קריאה — מנהל/אחראי; שינוי ומחיקה — מנהל (יומן לא נערך בדיעבד)
    match /gateOverrides/{id} {
      allow create: if hasRole();
      allow read: if isMgr() || isSup();
      allow update, delete: if isMgr();
    }

    // שאר האוספים — כל משתמש מחובר עם role
    // (stationLog נשאר כאן בכוונה — עובדים כותבים רשומות שיוך לתחנה)
    // ⚠️ כל אוסף שמקבל חוקים משלו חייב להופיע כאן ברשימת ההחרגה — Rules מאשרים
    // אם **איזשהו** match מאשר, ולכן בלי ההחרגה ה-catch-all היה עוקף את החוק הייעודי.
    match /{collection}/{docId} {
      allow read, write: if hasRole()
        && collection != 'credentials'
        && collection != 'adminSettings'
        && collection != 'workers'
        && collection != 'appSettings'
        && collection != 'stations'
        && collection != 'workerExpenses'
        && collection != 'attHistory'
        && collection != 'histTasks'
        && collection != 'products'
        && collection != 'productPricing'
        && collection != 'proformaInvoices'
        && collection != 'bizSignature'
        && collection != 'checkImages'
        // עד 25/09/2026 חסר כאן — וחוק הקופה הייעודי (לקיחה בלבד, על שמך) לא נאכף בפועל
        && collection != 'cashbox'
        && collection != 'voiceMsgs'
        && collection != 'thumbs'
        && collection != 'taskAlerts'
        && collection != 'wifiAlerts'
        && collection != 'workerWifi'
        && collection != 'workerMessages'
        && collection != 'mgrInbox'
        && collection != 'gateOverrides';
    }
  }
}
